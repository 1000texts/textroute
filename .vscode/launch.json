{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "TextRoute API",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/textroute-api/.venv/bin/python",
            "module": "uvicorn",
            "cwd": "${workspaceFolder}/textroute-api",
            "args": [
                "src.main:app",
                "--host",
                "0.0.0.0",
                "--port",
                "6060",
                "--reload"
            ],
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/textroute-api"
            },
            "console": "integratedTerminal",
            "jinja": true
        }
    ]
}
