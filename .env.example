COMPOSE_PROJECT_NAME=textroute

# Postgres (raw password; Compose only uses this on first volume init)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postgres

# App DSN. URL-encode reserved characters in the password, e.g. ( → %28  ) → %29
# Host tools / IDE debugger (API on the Mac, Postgres published on localhost:5432)
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/postgres
# API container inside Compose (hostname is the postgres service)
DATABASE_URL_DOCKER=postgresql://postgres:change-me@postgres:5432/postgres

# Moderator login (generate with: python -c "import secrets; print(secrets.token_hex(32))")
AUTH_SECRET=replace-with-at-least-32-random-bytes
AUTH_CHALLENGE_TTL_SECONDS=600
AUTH_SESSION_TTL_SECONDS=28800
AUTH_MAX_ATTEMPTS=5
AUTH_EXPOSE_DEVELOPMENT_CODE=true
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_NAME=textroute_session
MODERATOR_WEB_ORIGIN=http://localhost:5174

OLLAMA_BASE_URL=http://host.docker.internal:11434

# Dev only: local model files mounted into the API container
LLM_MODELS_HOST_PATH=/absolute/path/to/local/models
LLM_MODEL_PATH=/app/models
LLM_EMBEDDING_MODEL_GGUF=Qwen/Qwen3-Embedding-0.6B-GGUF/Qwen3-Embedding-0.6B-Q8_0.gguf

# Outbound SMS: logging (default) or http (+ SMS_PROVIDER_URL)
SMS_PROVIDER=logging
# SMS_PROVIDER_URL=http://host.docker.internal:9999/send

VITE_API_BASE_URL=http://localhost:6060
