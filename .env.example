COMPOSE_PROJECT_NAME=textroute

# ---------------------------------------------------------------------------
# Public domains (production only)
# Create A records for all four before requesting certificates.
# ---------------------------------------------------------------------------
API_DOMAIN=api.example.com
MODERATOR_DOMAIN=moderator.example.com
DOCS_DOMAIN=docs.example.com
SIMULATOR_DOMAIN=simulator.example.com

# Where Let's Encrypt renewal notices go.
LETSENCRYPT_EMAIL=you@example.com
# Host directory holding certificates. Certificates for other apps on the same
# box live here too and are left untouched.
LETSENCRYPT_DIR=/etc/letsencrypt

# Docker network the proxy joins. Another app on the same host can attach to it
# to be served through this nginx; see DEPLOY.md.
EDGE_NETWORK_NAME=textroute_web

# Optional: a directory of files nginx should serve directly on behalf of a
# co-hosted app, mounted read-only at /srv/local. Point it at that app's asset
# directory, not at a parent containing this checkout.
# LOCAL_STATIC_DIR=/srv/www/otherapp

# ---------------------------------------------------------------------------
# Postgres (raw password; Compose only uses this on first volume init)
# ---------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postgres

# App DSN. URL-encode reserved characters in the password, e.g. ( → %28  ) → %29
# Host tools / IDE debugger (API on your machine, Postgres published on 5432)
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/postgres
# API container inside Compose (hostname is the postgres service)
DATABASE_URL_DOCKER=postgresql://postgres:change-me@postgres:5432/postgres

# ---------------------------------------------------------------------------
# Secrets (generate with: python -c "import secrets; print(secrets.token_hex(32))")
# ---------------------------------------------------------------------------
AUTH_SECRET=replace-with-at-least-32-random-bytes

# Shared secret for the inbound SMS webhook. The endpoint is public, so without
# this anyone could forge inbound messages into a group. Unset means the
# webhook refuses every request.
WEBHOOK_SECRET=replace-with-random-bytes

AUTH_CHALLENGE_TTL_SECONDS=600
AUTH_SESSION_TTL_SECONDS=28800
AUTH_MAX_ATTEMPTS=5
AUTH_EXPOSE_DEVELOPMENT_CODE=true
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_NAME=textroute_session
MODERATOR_WEB_ORIGIN=http://localhost:5174

# Log every SQL statement and its bound parameters. Leave off in production:
# it logs phone numbers, message bodies, and login code hashes.
SQL_ECHO=false

OLLAMA_BASE_URL=http://host.docker.internal:11434

# Dev only: local model files mounted into the API container
LLM_MODELS_HOST_PATH=/absolute/path/to/local/models
LLM_MODEL_PATH=/app/models
LLM_EMBEDDING_MODEL_GGUF=Qwen/Qwen3-Embedding-0.6B-GGUF/Qwen3-Embedding-0.6B-Q8_0.gguf

# Outbound SMS: logging (default) or http (+ SMS_PROVIDER_URL)
SMS_PROVIDER=logging
# SMS_PROVIDER_URL=http://host.docker.internal:9999/send

# Dev only: the moderator UI and simulator call the API directly.
# In production these are built from the domains above instead.
VITE_API_BASE_URL=http://localhost:6060

# Database backups (infra/scripts/backup-db.sh)
BACKUP_DIR=/srv/backups/textroute
BACKUP_KEEP_DAYS=14
