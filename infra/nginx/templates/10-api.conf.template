# TextRoute API.
#
# ${API_DOMAIN} is substituted by the nginx image's envsubst entrypoint at
# container start. Only the variables named in NGINX_ENVSUBST_FILTER are
# substituted, so nginx's own runtime variables ($host, $remote_addr, ...)
# survive untouched.

server {
    listen 80;
    listen [::]:80;
    server_name ${API_DOMAIN};

    include /etc/nginx/snippets/acme-challenge.conf;

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${API_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${API_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${API_DOMAIN}/privkey.pem;
    include /etc/nginx/snippets/tls.conf;

    client_max_body_size 2m;

    location / {
        proxy_pass http://textroute:6060;
        include /etc/nginx/snippets/proxy.conf;
    }
}
