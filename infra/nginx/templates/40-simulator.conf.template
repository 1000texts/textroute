# SMS simulator: a testing tool that can inject inbound messages into real
# groups, so it is gated twice.
#
# 1. HTTP Basic auth on the whole vhost.
# 2. The webhook shared secret is injected here, server-side. The simulator is
#    built with VITE_API_BASE_URL=/api so it calls this origin instead of the
#    API's public origin; a Vite build would otherwise inline the secret into
#    public JavaScript. Same-origin also means no CORS is involved.

server {
    listen 80;
    listen [::]:80;
    server_name ${SIMULATOR_DOMAIN};

    include /etc/nginx/snippets/acme-challenge.conf;

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${SIMULATOR_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${SIMULATOR_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${SIMULATOR_DOMAIN}/privkey.pem;
    include /etc/nginx/snippets/tls.conf;

    auth_basic           "TextRoute SMS simulator";
    auth_basic_user_file /etc/nginx/secrets/simulator.htpasswd;

    root /srv/sms-simulator;
    index index.html;

    # Only the webhook is reachable through this origin. Scoping it here means
    # the injected secret can never ride along with some other API call.
    location /api/webhook/ {
        proxy_pass http://textroute:6060/webhook/;
        include /etc/nginx/snippets/proxy.conf;

        # Overrides any client-supplied value of the same header.
        proxy_set_header X-Webhook-Secret "${WEBHOOK_SECRET}";
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location / {
        try_files $uri /index.html;
    }
}
